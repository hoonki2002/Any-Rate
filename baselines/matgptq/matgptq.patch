+        if MOE_PRIOR > 0:   # modified by the Any-Rate authors: same rule as the Any-Rate MoE encoding: no routed token -> identity Hessian; fewer than MOE_PRIOR tokens -> isotropic prior of MOE_PRIOR tokens
